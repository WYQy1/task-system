# 复制成 .env 后按自己的环境改；不要提交 .env
DB_DSN=正式数据库用户名:正式数据库密码@tcp(正式数据库地址:3306)/task_system?parseTime=true
TEST_DB_DSN=测试数据库用户名:测试数据库密码@tcp(测试数据库地址:3306)/task_system_test?parseTime=true
SERVICE_TEST_DB_DSN=测试数据库用户名:测试数据库密码@tcp(测试数据库地址:3306)/task_system_service_test?parseTime=true
# 至少 32 字节，否则服务拒绝启动；生成方式：openssl rand -hex 32
JWT_SECRET=请替换成至少32字节的随机串例如0123456789abcdef0123456789abcdef
